{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"composite": true
	},
	"references": [
		{ "path": "packages/expressions" },
		{ "path": "packages/core" },
		{ "path": "packages/from-schema" },
		{ "path": "packages/react" }
	]
}
