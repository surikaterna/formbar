		"@formbar/tui": "workspace:*",
		"@playwright/test": "1.55.0",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"acorn": "8.15.0",
		"ink": "6.5.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"vite": "6.4.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "22.15.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"ink-testing-library": "4.0.0",
