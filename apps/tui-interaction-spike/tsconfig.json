{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": "../..",
		"paths": {
			"@formbar/arbiter": ["packages/arbiter/src/index.ts"],
			"@formbar/core": ["packages/core/src/index.ts"],
			"@formbar/expressions": ["packages/expressions/src/index.ts"],
			"@formbar/from-schema": ["packages/from-schema/src/index.ts"],
			"@formbar/react": ["packages/react/src/index.ts"],
			"@formbar/react-schema": ["packages/react-schema/src/index.ts"],
			"@formbar/tui": ["packages/tui/src/index.ts"]
		},
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"jsx": "react-jsx",
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node", "vitest/globals", "vite/client"]
	},
	"include": ["src"]
}
