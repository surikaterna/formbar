{
	"name": "@formbar/from-schema",
	"version": "0.15.3",
	"type": "module",
	"description": "Schema document projection and declarative form compilation",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/from-schema"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/from-schema/src/__tests__"
	},
	"dependencies": {
		"@formbar/core": "^0.15.0",
		"@formbar/declarative": "^0.15.0",
		"@formbar/expressions": "^0.14.3",
		"@scheman/core": "^2.0.0"
	},
	"peerDependencies": {
		"zod": ">=3.24.0 <4 || >=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"zod": "^4.0.0",
		"zod3-current": "npm:zod@3.25.76",
		"zod3-min": "npm:zod@3.24.0",
		"zod4-current": "npm:zod@4.5.4",
		"zod4-min": "npm:zod@4.0.0"
	}
}
