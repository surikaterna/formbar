{
	"name": "@formbar/from-schema",
	"version": "0.3.1",
	"type": "module",
	"description": "Schema-to-form ingestion for JSON Schema and Zod with layout compilation",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/from-schema"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/from-schema/src/__tests__"
	},
	"dependencies": {
		"@formbar/core": "^0.3.1",
		"@scheman/core": "^1.0.0"
	},
	"peerDependencies": {
		"zod": ">=3.24.0 <4 || >=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"zod": "^4.0.0",
		"zod3-current": "npm:zod@3.25.76",
		"zod3-min": "npm:zod@3.24.0",
		"zod4-current": "npm:zod@4.5.4",
		"zod4-min": "npm:zod@4.0.0"
	}
}
