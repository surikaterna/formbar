{
	"name": "@formbar/arbiter",
	"version": "0.14.2",
	"type": "module",
	"description": "Arbiter rule engine bridge for @formbar/core — declarative UI governance via production rules",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/arbiter"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
			"require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/arbiter/src/__tests__"
	},
	"dependencies": {
		"@formbar/expressions": "^0.14.2",
		"@formbar/core": "^0.14.2"
	},
	"peerDependencies": {
		"@arbitre/core": "^0.3.1",
		"kuery": "^2.1.1"
	},
	"devDependencies": {
		"@arbitre/core": "^0.3.1",
		"kuery": "^2.1.1"
	}
}
