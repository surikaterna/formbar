{
	"name": "@formbar/arbiter",
	"version": "0.14.0",
	"type": "module",
	"description": "Arbiter rule engine bridge for @formbar/core — declarative UI governance via production rules",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/arbiter"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/arbiter/src/__tests__"
	},
	"dependencies": {
		"@formbar/expressions": "^0.14.0",
		"@formbar/core": "^0.14.0"
	},
	"peerDependencies": {
		"@arbitre/core": "^0.3.0",
		"kuery": "^2.1.0"
	},
	"devDependencies": {
		"@arbitre/core": "^0.3.0",
		"kuery": "^2.1.0"
	}
}
