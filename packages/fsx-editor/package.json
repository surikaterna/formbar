{
	"name": "@formbar/fsx-editor",
	"version": "0.1.0-rc.0",
	"type": "module",
	"description": "Presentation-only FSX highlighting for CodeMirror 6",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/fsx-editor"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/fsx-editor/src/__tests__"
	},
	"dependencies": {
		"@formbar/fsx-authoring": "^0.1.0-rc.1"
	},
	"peerDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13"
	}
}
