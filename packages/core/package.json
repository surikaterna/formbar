{
	"name": "@formbar/core",
	"version": "0.22.0",
	"type": "module",
	"description": "Headless form state engine with validation, transforms, and middleware",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/core"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./path": {
			"import": {
				"types": "./dist/path.entry.d.ts",
				"default": "./dist/path.entry.js"
			},
			"require": {
				"types": "./dist/path.entry.d.cts",
				"default": "./dist/path.entry.cjs"
			}
		},
		"./transforms": {
			"import": {
				"types": "./dist/transforms.entry.d.ts",
				"default": "./dist/transforms.entry.js"
			},
			"require": {
				"types": "./dist/transforms.entry.d.cts",
				"default": "./dist/transforms.entry.cjs"
			}
		},
		"./validation": {
			"import": {
				"types": "./dist/validation.entry.d.ts",
				"default": "./dist/validation.entry.js"
			},
			"require": {
				"types": "./dist/validation.entry.d.cts",
				"default": "./dist/validation.entry.cjs"
			}
		},
		"./internal/scoped-sync": {
			"import": {
				"types": "./dist/internal/scoped-sync.d.ts",
				"default": "./dist/internal/scoped-sync.js"
			},
			"require": {
				"types": "./dist/internal/scoped-sync.d.cts",
				"default": "./dist/internal/scoped-sync.cjs"
			}
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/core/src/__tests__"
	},
	"dependencies": {
		"@formbar/expressions": "^0.14.3"
	}
}
