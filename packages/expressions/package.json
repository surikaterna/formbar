{
	"name": "@formbar/expressions",
	"version": "0.14.2",
	"type": "module",
	"description": "Authorized reactive Formbar expressions powered by Kuery",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/expressions"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
			"require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
		}
	},
	"files": ["dist", "docs"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/expressions/src/__tests__"
	},
	"dependencies": {
		"kuery": "^2.1.1"
	}
}
