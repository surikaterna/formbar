{
	"name": "@formbar/react-schema",
	"version": "0.7.0",
	"type": "module",
	"description": "React preparation hook for schema-compiled forms",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/react-schema"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/react-schema/src/__tests__"
	},
	"dependencies": {
		"@formbar/core": "^0.7.0",
		"@formbar/declarative": "^0.7.0",
		"@formbar/react": "^0.7.0",
		"@formbar/from-schema": "^0.7.0"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0"
	}
}
