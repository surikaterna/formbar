{
	"name": "@formbar/declarative",
	"version": "1.0.0",
	"type": "module",
	"description": "Framework-neutral serialized form definition contracts",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/declarative"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./internal/omission-supplier": {
			"import": {
				"types": "./dist/internal/omission-supplier.d.ts",
				"default": "./dist/internal/omission-supplier.js"
			},
			"require": {
				"types": "./dist/internal/omission-supplier.d.cts",
				"default": "./dist/internal/omission-supplier.cjs"
			}
		},
		"./internal/scoped-sync": {
			"import": {
				"types": "./dist/internal/scoped-sync.d.ts",
				"default": "./dist/internal/scoped-sync.js"
			},
			"require": {
				"types": "./dist/internal/scoped-sync.d.cts",
				"default": "./dist/internal/scoped-sync.cjs"
			}
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/declarative/src/__tests__"
	},
	"dependencies": {
		"@formbar/core": "^1.0.0",
		"@formbar/expressions": "^0.14.3"
	}
}
