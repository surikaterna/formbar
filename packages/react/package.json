{
	"name": "@formbar/react",
	"version": "0.21.0",
	"type": "module",
	"description": "React hooks and a11y utilities for @formbar/core",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/react"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/react/src/__tests__"
	},
	"dependencies": {
		"@formbar/expressions": "^0.14.3",
		"@formbar/core": "^0.21.0"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react-dom": "^19.0.0",
		"react-dom": "^19.0.0",
		"jsdom": "^26.0.0",
		"@types/react": "^19.0.0",
		"react": "^19.0.0"
	}
}
