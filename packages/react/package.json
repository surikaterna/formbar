{
	"name": "@formbar/react",
	"version": "0.3.1",
	"type": "module",
	"description": "React hooks and a11y utilities for @formbar/core",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surikaterna/formbar.git",
		"directory": "packages/react"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run --root ../.. packages/react/src/__tests__"
	},
	"dependencies": {
		"@formbar/core": "^0.3.1"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0"
	}
}
